/* GameScreen layout */

/* Tutorial modal */
#tutorial-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(12, 12, 12, 0.9);
}

#tutorial-inner {
    border-width: 4px;
    border-color: var(--nes-white);
    background-color: var(--nes-black);
    padding: 32px;
    align-items: center;
}

#tutorial-title {
    color: var(--nes-gold);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

#tutorial-subtitle {
    color: var(--nes-white);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

#tutorial-objective {
    color: var(--nes-green);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

#tutorial-clips {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.tutorial-clip {
    align-items: center;
    margin: 0 24px;
    max-width: 360px;
}

.tutorial-video {
    width: 320px;
    height: 320px;
    border-width: 3px;
    border-color: var(--nes-white);
    margin-bottom: 12px;
}

.tutorial-clip appui--text {
    color: var(--nes-white);
    -unity-text-align: middle-center;
    white-space: normal;
}

#tutorial-countdown {
    color: var(--nes-gray);
    -unity-text-align: middle-center;
    margin-top: 20px;
}

#game-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

#timer-text {
    color: var(--nes-white);
    -unity-text-align: middle-center;
    position: absolute;
    top: 16px;
    left: 0;
    right: 0;
}

#win-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(12, 12, 12, 0.85);
}

#win-panel-inner {
    border-width: 4px;
    border-color: var(--nes-white);
    background-color: var(--nes-black);
    padding: 32px;
    min-width: 500px;
    align-items: center;
}

#winner-text {
    color: var(--nes-gold);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

#winner-photo {
    width: 128px;
    height: 128px;
    border-width: 3px;
    border-color: var(--nes-gold);
    margin-bottom: 16px;
}

#final-time-text {
    color: var(--nes-white);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

#high-score-label {
    color: var(--nes-red);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

#high-score-list {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 16px;
}

.score-entry {
    flex-direction: column;
    align-items: center;
    width: 80px;
    margin: 4px 6px;
}

.score-photo {
    width: 56px;
    height: 56px;
    border-width: 2px;
    border-color: var(--nes-white);
    margin-bottom: 4px;
}

.score-text {
    color: var(--nes-white);
    -unity-text-align: middle-center;
    font-size: 8px;
}

#restart-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
}

#gesture-icon {
    width: 48px;
    height: 48px;
    border-width: 2px;
    border-color: var(--nes-white);
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url('/Assets/Media/frame_last.png');
}

#instructions-text {
    color: var(--nes-gray);
    -unity-text-align: middle-left;
}

#countdown-text {
    color: var(--nes-gold);
    -unity-text-align: middle-center;
    margin-top: 8px;
}
