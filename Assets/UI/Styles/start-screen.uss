/* StartScreen layout */

#start-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: transparent;
}

/* Center column: title, prompt, countdown stacked vertically */
#center-column {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#title-text {
    color: var(--nes-gold);
    -unity-text-align: middle-center;
    font-size: 64px;
    margin-bottom: 40px;
}

#prompt-text {
    color: var(--nes-white);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

#countdown-text {
    color: var(--nes-red);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    font-size: 24px;
}

/* Player status: positioned below each video quad */
#p1-status {
    position: absolute;
    left: 0;
    width: 50%;
    bottom: 60px;
    color: var(--nes-green);
    font-size: 24px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

#p2-status {
    position: absolute;
    right: 0;
    width: 50%;
    bottom: 60px;
    color: var(--nes-blue);
    font-size: 24px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
