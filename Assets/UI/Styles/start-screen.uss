/* StartScreen layout */

#start-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: transparent;
}

/* Center column: title, prompt, countdown stacked vertically */
#center-column {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#title-text {
    color: var(--nes-gold);
    -unity-text-align: middle-center;
    font-size: 64px;
    margin-bottom: 40px;
}

#prompt-text {
    color: var(--nes-white);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

#countdown-text {
    color: var(--nes-red);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    font-size: 24px;
}

/* Player status: absolutely positioned on left and right flanks,
   vertically centered so they sit beside the video quad */
#p1-status {
    position: absolute;
    left: 32px;
    top: 50%;
    translate: 0 -50%;
    color: var(--nes-green);
    font-size: 40px;
    -unity-text-align: middle-left;
    white-space: normal;
    max-width: 200px;
}

#p2-status {
    position: absolute;
    right: 32px;
    top: 50%;
    translate: 0 -50%;
    color: var(--nes-blue);
    font-size: 40px;
    -unity-text-align: middle-right;
    white-space: normal;
    max-width: 200px;
}
